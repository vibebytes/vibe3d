{
  "name": "mannequin-run",
  "template": "empty",
  "steps": [
    {
      "call": "mesh.mannequin",
      "params": { "name": "Runner", "pose": "stand" },
      "as": "m",
      "expect": {
        "assert": [
          { "path": "asset.gltf.skins", "eq": 1 },
          { "path": "bones", "len": 17 },
          { "path": "node.kind", "eq": "model" }
        ]
      }
    },
    {
      "call": "animation.gait",
      "params": { "nodeId": "@Runner", "style": "run" },
      "expect": {
        "assert": [
          { "path": "nodeId", "eq": "$m.nodeId" },
          { "path": "period", "eq": 0.7 },
          { "path": "drift.0", "eq": 0 }
        ]
      }
    },
    {
      "call": "render.sequence",
      "params": { "nodeIds": ["$m.nodeId"], "view": "three_quarter", "from": 0, "to": 1, "fps": 4, "width": 160, "height": 90 },
      "as": "seq"
    },
    {
      "call": "job.get",
      "params": { "jobId": "$seq.jobId" },
      "expect": {
        "assert": [
          { "path": "state", "eq": "done" },
          { "path": "kind", "eq": "render.sequence" },
          { "path": "frames", "eq": 5 }
        ]
      }
    }
  ]
}
