{
  "name": "@vibebyte/vibe3d-capabilities",
  "version": "0.2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": ["dist", "generated"],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "gen": "tsx src/gen/cli.ts"
  },
  "dependencies": {
    "@vibebyte/vibe3d-protocol": "workspace:*",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}
