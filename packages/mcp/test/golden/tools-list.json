  {
    "name": "vibe3d_export_glb",
    "description": "[export_glb] 导出 GLB（任务制，用 vibe3d_job 查进度）｜拿到 jobId 后轮询 vibe3d_job.get 到 state=done（失败看 error）",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "node_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^n_[a-z0-9]{8}$"
          },
          "description": "只导出这些节点（含子树）；省略则导出整场景"
        },
        "include": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "cameras",
              "lights"
            ]
          },
          "maxItems": 2,
          "description": "额外带上相机 / 灯光；默认不带"
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
