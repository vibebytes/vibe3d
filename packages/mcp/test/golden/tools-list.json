  {
    "name": "vibe3d_open_editor",
    "description": "[open_editor] 打开房间编辑器（默认弹窗）｜返回 url 与 hint；open:false 只回链接",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "focus": {
          "type": "string",
          "pattern": "^n_[a-z0-9]{8}$",
          "description": "打开后选中并聚焦到该节点"
        },
        "reuse": {
          "type": "boolean",
          "description": "复用已开的同房间编辑页；false 强制新开一个"
        },
        "open": {
          "type": "boolean",
          "description": "true（默认）直接弹窗；false 只返回 url 不弹"
        },
        "room_id": {
          "type": "string",
          "pattern": "^r_[a-z0-9]{8}$",
          "description": "房间 id；省略时用当前会话绑定的房间"
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "vibe3d_apply_ops",
    "description": "[apply_ops] 原子批量 op（仅用于跨节点依赖；日常请用专用工具）｜嵌套载荷包在同名字段 {op:\"node.create\",node:{…}} / {op:\"env.set\",env:{…}}，不能平铺到 op 顶层（会校验失败）；ops 传数组不是 JSON 字符串。逐条操作请用专用工具",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
