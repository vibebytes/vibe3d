[
  {
    "name": "vibe3d_help",
    "description": "查参数契约：给 tool(+op) 返回该 op 的参数字段/必填/枚举/错误码与示例；不给 tool 则列出全部工具与 op",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "tool": {
          "type": "string",
          "enum": [
            "vibe3d_status",
            "vibe3d_room",
            "vibe3d_scene",
            "vibe3d_node",
            "vibe3d_material",
            "vibe3d_stage",
            "vibe3d_animation",
            "vibe3d_fx",
            "vibe3d_mesh",
            "vibe3d_asset",
            "vibe3d_camera",
            "vibe3d_render",
            "vibe3d_export_glb",
            "vibe3d_job",
            "vibe3d_open_editor",
            "vibe3d_apply_ops"
          ],
          "description": "工具名；省略则列出全部工具与 op"
        },
        "op": {
          "type": "string",
          "enum": [
            "status",
            "create",
            "list",
            "use",
            "get",
            "close",
            "timeline",
            "summary",
            "query",
            "stats",
            "pick",
            "validate",
            "undo",
            "redo",
            "diff",
            "export",
            "import",
            "checkpoint",
            "checkpoints",
            "restore",
            "selection",
            "update",
            "delete",
            "clone",
            "reparent",
            "transform",
            "array",
            "attach",
            "group",
            "merge",
            "patch",
            "map",
            "assign",
            "set",
            "env",
            "define",
            "play",
            "stop",
            "clear",
            "pose",
            "boolean",
            "tube",
            "backdrop",
            "decal",
            "inspect",
            "put",
            "save",
            "project",
            "unproject",
            "snapshot",
            "views",
            "node",
            "assert",
            "id_pass",
            "sequence",
            "glb",
            "cancel",
            "open",
            "apply"
          ],
          "description": "该工具下的 op；省略则返回该工具全部 op"
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "vibe3d_status",
    "description": "[status] 能力探测：渲染器是否就绪、能否出 ID 通道、快照上限与载荷上限｜含 id-pass 支持；渲染或导入前先查一次",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "vibe3d_room",
    "description": "[room] 房间：建 / 列 / 切绑定 / 看摘要 / 关 / 时间线｜op: [read] list use get timeline；[write] create close｜必填见 params 描述，字段见 vibe3d_help {tool, op}",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "create",
            "list",
            "use",
            "get",
            "close",
            "timeline"
          ],
          "description": "room 下的 op；每个 op 的参数字段用 vibe3d_help {tool, op} 查"
        },
        "params": {
          "type": "object",
          "description": "必填字段：use{room_id}。参数可平铺在顶层（顶层优先），省略 params 时取其顶层字段"
        },
        "room_id": {
          "type": "string",
          "pattern": "^r_[a-z0-9]{8}$",
          "description": "房间 id；省略时用当前会话绑定的房间"
        }
      },
      "required": [
        "op"
      ],
      "additionalProperties": true
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "vibe3d_scene",
    "description": "[scene] 场景：取整份 / 摘要 / 查询节点 / 统计 / 拾取 / 体检 / 撤销重做 / 差分 / 导入导出 / 检查点 / 当前选中｜op: [read] get summary query stats pick validate diff export checkpoints selection；[write] undo redo import checkpoint restore｜必填见 params 描述，字段见 vibe3d_help {tool, op}｜import 是整场景替换，仅用于初始化或回滚",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "get",
            "summary",
            "query",
            "stats",
            "pick",
            "validate",
            "undo",
            "redo",
            "diff",
            "export",
            "import",
            "checkpoint",
            "checkpoints",
            "restore",
            "selection"
          ],
          "description": "scene 下的 op；每个 op 的参数字段用 vibe3d_help {tool, op} 查"
        },
        "params": {
          "type": "object",
          "description": "必填字段：import{doc} restore{checkpoint_id}。参数可平铺在顶层（顶层优先），省略 params 时取其顶层字段"
        }
      },
      "required": [
        "op"
      ],
      "additionalProperties": true
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "vibe3d_node",
    "description": "[node] 节点：建 / 改 / 删 / 克隆 / 读 / 换父 / 批量变换 / 阵列 / 吸附 / 编组 / 合并烘焙 / 导入模型｜op: [read] get；[write] create update delete clone reparent transform array attach group merge import｜必填见 params 描述，字段见 vibe3d_help {tool, op}｜create 平铺传 kind+shape+size，material 可省略（自动建）",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "create",
            "update",
            "delete",
            "clone",
            "get",
            "reparent",
            "transform",
            "array",
            "attach",
            "group",
            "merge",
            "import"
          ],
          "description": "node 下的 op；每个 op 的参数字段用 vibe3d_help {tool, op} 查"
        },
        "params": {
          "type": "object",
          "description": "必填字段：create{kind} update{node_id,patch} delete{node_id} clone{node_id} get{node_id} reparent{node_id,parent} array{node_id,count} attach{node_id,target_id,face} group{ids,name} merge{node_id}。参数可平铺在顶层（顶层优先），省略 params 时取其顶层字段"
        }
      },
      "required": [
        "op"
      ],
      "additionalProperties": true
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "vibe3d_material",
    "description": "[material] 材质：按预设建 / 局部改 / 贴图与 UV / 批量指派｜op: create patch map assign｜必填见 params 描述，字段见 vibe3d_help {tool, op}｜create 收 {preset}，id 由服务端生成；preset 任意描述词都收（如 matte-white 会归一到 concrete + 浅色），原名回读在 preset/presetNote；patch 用 baseColor（也接受 color 别名）/metalness/roughness/emissive/opacity",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "create",
            "patch",
            "map",
            "assign"
          ],
          "description": "material 下的 op；每个 op 的参数字段用 vibe3d_help {tool, op} 查"
        },
        "params": {
          "type": "object",
          "description": "必填字段：patch{material_id,patch} map{material_id} assign{material_id}。参数可平铺在顶层（顶层优先），省略 params 时取其顶层字段"
        }
      },
      "required": [
        "op"
      ],
      "additionalProperties": true
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
