{
  "name": "@vibebyte/vibe3d-daemon",
  "version": "0.2.3",
  "description": "Local vibe3d daemon: rooms, editor UI, and Chromium-backed 3D rendering for MCP.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./app": {
      "types": "./src/server.ts",
      "default": "./src/server.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "vibe3d-daemon": "./dist/index.js"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./app": {
        "types": "./dist/server.d.ts",
        "import": "./dist/server.js"
      }
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsup && node scripts/copy-editor.mjs && chmod +x dist/index.js"
  },
  "devDependencies": {
    "@hono/node-server": "^1.13.7",
    "@types/ws": "^8.5.13",
    "@vibebyte/vibe3d-capabilities": "workspace:*",
    "@vibebyte/vibe3d-protocol": "workspace:*",
    "@vibebyte/vibe3d-scene": "workspace:*",
    "hono": "^4.6.14",
    "tsx": "^4.19.2",
    "ws": "^8.18.0",
    "zod": "^3.25.76"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/vibebytes/vibe3d#readme",
  "bugs": {
    "url": "https://github.com/vibebytes/vibe3d/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibebytes/vibe3d.git",
    "directory": "packages/daemon"
  }
}
